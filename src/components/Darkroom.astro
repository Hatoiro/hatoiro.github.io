---
// Contact sheets. Tap a frame → full-screen viewer (Lightbox) at the photo's own shape.
// Frames come from photos/ via scripts/build-photos.mjs → src/data/photos.json.
import photos from '../data/photos.json';
import { hub } from '../data/site';
type Frame = { thumb: string; full: string; title: string; date?: string; lens?: string; aperture?: string };
type Roll = { id: string; label: string; note?: string; year?: string; period?: string; camera: string; frames: Frame[] };
interface Props { full?: boolean }
const { full = false } = Astro.props;
const rolls = (photos.rolls as Roll[]).filter((r) => r.frames.length);
// ハブでは新しいロール4本まで、各12コマまで。/photos/ では全部
const shown = full ? rolls : rolls.slice(0, 4).map((r) => ({ ...r, frames: r.frames.slice(0, 12) }));
const groups: { title: string; rolls: { r: Roll; i: number }[] }[] = [];
shown.forEach((r, i) => { const t = r.year || 'Everyday'; const g = groups.find((x) => x.title === t); g ? g.rolls.push({ r, i }) : groups.push({ title: t, rolls: [{ r, i }] }); });
const caption = (r: Roll, f: Frame, n: number) => [r.label + (r.period ? ` ${r.period}` : ''), `#${n}`, f.title, f.date, r.camera, f.lens, f.aperture].filter(Boolean).join(' · ');
const tones = ['#5B574F', '#2E2D2A', '#8E887C', '#3F3D38', '#B4AE9F', '#4A4741'];
---
<div class="darkroom" data-darkroom>
  {shown.length === 0 ? (
    <div class="empty">
      <div class="strip" aria-hidden="true">
        <div class="sprk"></div>
        <div class="frames">{tones.map((t) => <span class="blank" style={`background:${t}`}></span>)}</div>
        <div class="sprk"></div>
      </div>
      <p class="empty-note">{hub.darkroomEmpty}</p>
    </div>
  ) : (
    <>
      <div class="tabs" role="tablist" aria-label="ロール">
        {groups.map((g) => (
          <div class="tab-group">
            {full && <span class="tg">{g.title}</span>}
            {g.rolls.map(({ r, i }) => (
              <button type="button" class="pill" role="tab" aria-selected={i === 0 ? 'true' : 'false'} aria-pressed={i === 0 ? 'true' : 'false'} data-roll-tab={r.id}>{r.label}{!full && r.period ? ` · ${r.period}` : ''}</button>
            ))}
          </div>
        ))}
      </div>
      <div class="table">
        {shown.map((r, ri) => (
          <div class="sheet" data-roll={r.id} hidden={ri !== 0}>
            <p class="sheet-head"><span>Roll {String(ri + 1).padStart(2, '0')} — {r.label}{r.period && ` · ${r.period}`}{r.note && ` · ${r.note}`}</span><span>{r.camera}</span></p>
            {Array.from({ length: Math.ceil(r.frames.length / 6) }, (_, si) => (
              <div class="strip">
                <div class="sprk"></div>
                <div class="frames">
                  {r.frames.slice(si * 6, si * 6 + 6).map((f, fi) => {
                    const n = si * 6 + fi + 1;
                    return (
                      <button type="button" class="frame" data-lb-src={f.full} data-lb-group={`roll-${r.id}`} data-lb-cap={caption(r, f, n)} aria-label={`${r.label} ${n} を拡大`}>
                        <img src={f.thumb} alt={f.title || `${r.label} ${n}`} loading="lazy" decoding="async" />
                        <span class="no">▸ {n}</span>
                        <span class="ring" aria-hidden="true"></span>
                      </button>
                    );
                  })}
                </div>
                <div class="sprk"></div>
              </div>
            ))}
            <p class="hint">コマをタップすると、大きく表示されます。</p>
          </div>
        ))}
      </div>
    </>
  )}
</div>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-darkroom]')) {
    const tabs = root.querySelectorAll<HTMLButtonElement>('[data-roll-tab]');
    const sheets = root.querySelectorAll<HTMLElement>('[data-roll]');
    tabs.forEach((t) => t.addEventListener('click', () => {
      tabs.forEach((x) => { const on = x === t; x.setAttribute('aria-selected', String(on)); x.setAttribute('aria-pressed', String(on)); });
      sheets.forEach((s) => { s.hidden = s.dataset.roll !== t.dataset.rollTab; });
    }));
    // 赤丸 = いま見ている（最後に見た）コマ
    root.addEventListener('lb:show', (e) => {
      root.querySelectorAll('.frame.seen').forEach((x) => x.classList.remove('seen'));
      (e.target as HTMLElement).classList.add('seen');
    });
  }
</script>

<style>
  .tabs { display: flex; flex-direction: column; gap: 10px; margin-bottom: 24px; }
  .tab-group { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
  .tg { flex: 0 0 96px; font: 400 12px var(--f-mono); letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted-on-dark); }
  .table { background: #F1EEE6; padding: clamp(12px, 2vw, 24px); box-shadow: 0 40px 120px rgba(255, 240, 210, 0.07); }
  .sheet { display: flex; flex-direction: column; gap: 12px; }
  .sheet-head { margin: 0 0 4px; display: flex; flex-wrap: wrap; justify-content: space-between; gap: 4px 12px; font: 400 11px var(--f-mono); color: #45423C; }
  .strip { background: #161512; padding: 4px 10px; }
  .sprk { height: 16px; background-image: repeating-linear-gradient(90deg, transparent 0 8px, #45423C 8px 20px, transparent 20px 28px); background-size: 28px 8px; background-repeat: repeat-x; background-position: 0 4px; }
  .frames { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 10px; }
  .frame { position: relative; padding: 0; border: 0; background: transparent; cursor: zoom-in; display: flex; flex-direction: column; gap: 4px; text-align: left; }
  .frame img { width: 100%; aspect-ratio: 3 / 2; object-fit: cover; background: #2E2D2A; transition: filter 0.2s; }
  .frame:hover img { filter: brightness(1.12); }
  .no { font: 400 10px var(--f-mono); color: #E7A13A; }
  .ring { position: absolute; inset: -10px -8px 8px; border: 3px solid #E5483B; border-radius: 50%; transform: rotate(-4deg); opacity: 0; transition: opacity 0.2s; pointer-events: none; }
  .frame.seen .ring { opacity: 1; }
  .hint { margin: 4px 0 0; font: 400 11px var(--f-mono); color: #6E685D; }
  .empty .frames .blank { aspect-ratio: 3 / 2; display: block; }
  .empty-note { margin: 18px 0 0; font-size: 15px; color: var(--muted-on-dark); }
  @media (max-width: 600px) { .frames { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
</style>
