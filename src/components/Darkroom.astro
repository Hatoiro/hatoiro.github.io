---
// Contact sheets + loupe. Used on the hub (first rolls) and on /photos/ (everything).
// Frames come from photos/ via scripts/build-photos.mjs → src/data/photos.json.
import photos from '../data/photos.json';
import { hub } from '../data/site';
type Frame = { src: string; thumb: string; title: string; date?: string; lens?: string; aperture?: string };
const rolls = photos.rolls as { id: string; label: string; camera: string; frames: Frame[] }[];
interface Props { full?: boolean }
const { full = false } = Astro.props;
const withFrames = rolls.filter((r) => r.frames.length);
const shown = full ? withFrames : withFrames.map((r) => ({ ...r, frames: r.frames.slice(0, 12) }));
const first = shown[0]?.frames[0];
const tones = ['#5B574F', '#2E2D2A', '#8E887C', '#3F3D38', '#B4AE9F', '#4A4741'];
---
<div class="darkroom" data-darkroom>
  {shown.length === 0 ? (
    <div class="empty">
      <div class="strip" aria-hidden="true">
        <div class="sprk"></div>
        <div class="frames">{tones.map((t) => <span class="blank" style={`background:${t}`}></span>)}</div>
        <div class="sprk"></div>
      </div>
      <p class="empty-note">{hub.darkroomEmpty}</p>
    </div>
  ) : (
    <>
      <div class="tabs" role="tablist" aria-label="ロール">
        {shown.map((r, i) => (
          <button type="button" class="pill" role="tab" aria-selected={i === 0 ? 'true' : 'false'} aria-pressed={i === 0 ? 'true' : 'false'} data-roll-tab={r.id}>Roll {String(i + 1).padStart(2, '0')} · {r.label}</button>
        ))}
      </div>
      <div class="room">
        <div class="table">
          {shown.map((r, ri) => (
            <div class="sheet" data-roll={r.id} hidden={ri !== 0}>
              <p class="sheet-head"><span>Roll {String(ri + 1).padStart(2, '0')} — {r.label}</span><span>{r.camera}</span></p>
              {Array.from({ length: Math.ceil(r.frames.length / 6) }, (_, si) => (
                <div class="strip">
                  <div class="sprk"></div>
                  <div class="frames">
                    {r.frames.slice(si * 6, si * 6 + 6).map((f, fi) => (
                      <button type="button" class="frame" aria-pressed={ri === 0 && si === 0 && fi === 0 ? 'true' : 'false'}
                        data-src={f.src} data-title={f.title} data-meta={[r.label, f.date, f.lens, f.aperture].filter(Boolean).join(' · ')}
                        data-no={`${String(ri + 1).padStart(2, '0')} · ${si * 6 + fi + 1}`} aria-label={f.title || `${r.label} ${si * 6 + fi + 1}`}>
                        <img src={f.thumb} alt="" loading="lazy" decoding="async" />
                        <span class="no">▸ {si * 6 + fi + 1}</span>
                        <span class="ring" aria-hidden="true"></span>
                      </button>
                    ))}
                  </div>
                  <div class="sprk"></div>
                </div>
              ))}
            </div>
          ))}
        </div>
        <aside class="loupe-wrap" aria-live="polite">
          <div class="loupe"><img data-loupe-img src={first?.src} alt={first?.title ?? ''} /></div>
          <p class="meta-no" data-loupe-no>{`01 · 1`}</p>
          <p class="meta-title" data-loupe-title>{first?.title}</p>
          <p class="meta-sub" data-loupe-meta>{[shown[0]?.label, first?.date, first?.lens, first?.aperture].filter(Boolean).join(' · ')}</p>
        </aside>
      </div>
    </>
  )}
</div>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-darkroom]')) {
    const tabs = root.querySelectorAll<HTMLButtonElement>('[data-roll-tab]');
    const sheets = root.querySelectorAll<HTMLElement>('[data-roll]');
    const img = root.querySelector<HTMLImageElement>('[data-loupe-img]');
    const set = (sel: string, v: string) => { const el = root.querySelector(sel); if (el) el.textContent = v; };
    const pick = (b: HTMLButtonElement) => {
      root.querySelectorAll('.frame[aria-pressed="true"]').forEach((x) => x.setAttribute('aria-pressed', 'false'));
      b.setAttribute('aria-pressed', 'true');
      if (img) { img.src = b.dataset.src || ''; img.alt = b.dataset.title || ''; }
      set('[data-loupe-no]', b.dataset.no || ''); set('[data-loupe-title]', b.dataset.title || ''); set('[data-loupe-meta]', b.dataset.meta || '');
    };
    root.querySelectorAll<HTMLButtonElement>('.frame').forEach((b) => b.addEventListener('click', () => pick(b)));
    tabs.forEach((t) => t.addEventListener('click', () => {
      tabs.forEach((x) => { const on = x === t; x.setAttribute('aria-selected', String(on)); x.setAttribute('aria-pressed', String(on)); });
      sheets.forEach((s) => { s.hidden = s.dataset.roll !== t.dataset.rollTab; });
      const firstFrame = root.querySelector<HTMLButtonElement>(`[data-roll="${t.dataset.rollTab}"] .frame`);
      if (firstFrame) pick(firstFrame);
    }));
  }
</script>

<style>
  .tabs { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 24px; }
  .room { display: flex; flex-wrap: wrap; gap: 32px; align-items: flex-start; }
  .table { flex: 999 1 600px; background: #F1EEE6; padding: 22px; box-shadow: 0 40px 120px rgba(255, 240, 210, 0.07); }
  .sheet { display: flex; flex-direction: column; gap: 12px; }
  .sheet-head { margin: 0 0 4px; display: flex; justify-content: space-between; gap: 12px; font: 400 11px var(--f-mono); color: #45423C; }
  .strip { background: #161512; padding: 4px 10px; }
  .sprk { height: 16px; background-image: repeating-linear-gradient(90deg, transparent 0 8px, #45423C 8px 20px, transparent 20px 28px); background-size: 28px 8px; background-repeat: repeat-x; background-position: 0 4px; }
  .frames { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 8px; }
  .frame { position: relative; padding: 0; border: 0; background: transparent; cursor: pointer; display: flex; flex-direction: column; gap: 4px; text-align: left; }
  .frame img { width: 100%; aspect-ratio: 3 / 2; object-fit: cover; background: #2E2D2A; }
  .no { font: 400 10px var(--f-mono); color: #E7A13A; }
  .ring { position: absolute; inset: -10px -8px 8px; border: 3px solid #E5483B; border-radius: 50%; transform: rotate(-4deg); opacity: 0; transition: opacity 0.2s; pointer-events: none; }
  .frame[aria-pressed="true"] .ring { opacity: 1; }
  .loupe-wrap { flex: 1 1 300px; display: flex; flex-direction: column; gap: 6px; }
  .loupe { width: min(300px, 100%); aspect-ratio: 1; border-radius: 50%; border: 12px solid #2C2A26; box-shadow: inset 0 0 0 2px #4A4740, 0 30px 80px rgba(0, 0, 0, 0.6); overflow: hidden; margin: 0 auto 16px; background: #2E2D2A; }
  .loupe img { width: 100%; height: 100%; object-fit: cover; }
  .meta-no { margin: 0; font: 400 12px var(--f-mono); color: #E7A13A; }
  .meta-title { margin: 0; font: 400 40px/1 var(--f-serif); }
  .meta-sub { margin: 0; font: 400 12px var(--f-mono); color: var(--muted-on-dark); }
  .empty .frames .blank { aspect-ratio: 3 / 2; display: block; }
  .empty-note { margin: 18px 0 0; font-size: 15px; color: var(--muted-on-dark); }
  @media (max-width: 600px) { .frames { grid-template-columns: repeat(3, minmax(0, 1fr)); } .table { padding: 12px; } }
</style>
