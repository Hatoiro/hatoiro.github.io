---
const nav = [
  { href: '/#podcast', label: 'Podcast' },
  { href: '/photos/', label: 'Photos' },
  { href: '/#chronicle', label: 'Chronicle' },
  { href: '/#works', label: 'Works' },
  { href: '/about/', label: 'About' },
];
---
<header class="site-header">
  <div class="wrap bar">
    <a href="/" class="mark"><span class="ja">石黒晴翔</span><span class="en">Haruto Ishiguro</span></a>
    <nav aria-label="メイン">
      {nav.map((n) => <a href={n.href}>{n.label}</a>)}
      <a href="/room/" class="room">Room ↗</a>
    </nav>
  </div>
</header>

<style>
  .site-header { position: sticky; top: 0; z-index: 20; background: rgba(243, 239, 230, 0.9); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); border-bottom: 1px solid var(--ink); }
  .bar { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 10px 24px; padding-block: 14px; }
  .mark { display: flex; align-items: baseline; gap: 12px; text-decoration: none; }
  .mark .ja { font-size: 19px; font-weight: var(--w-black); letter-spacing: 0.16em; }
  .mark .en { font-size: 15px; font-weight: var(--w-thin); letter-spacing: 0.04em; }
  nav { display: flex; flex-wrap: wrap; gap: 4px 22px; font-size: 14px; font-weight: var(--w-bold); }
  nav a { text-decoration: none; padding-block: 6px; }
  nav .room { color: var(--red); }
  @media (max-width: 600px) { .mark .en { display: none; } nav { gap: 4px 16px; font-size: 13px; } }
</style>
