---
// サイトは「部屋」の集まり。ナビもそれぞれの部屋へのドア
const nav = [
  { href: '/#studyroom', label: 'Studyroom' },
  { href: '/darkroom/', label: 'Darkroom' },
  { href: '/#map', label: 'Map room' },
  { href: '/#archive', label: 'Archive room' },
  { href: '/#lab', label: 'Lab room' },
  { href: '/front-room/', label: 'Front room' },
];
---
<header class="site-header">
  <div class="wrap bar">
    <a href="/" class="mark"><span class="ja">石黒晴翔</span><span class="en">Haruto Ishiguro</span></a>
    <nav aria-label="メイン">
      {nav.map((n) => <a href={n.href}>{n.label}</a>)}
      <a href="/room/" class="room">My room ↗</a>
    </nav>
  </div>
</header>

<style>
  .site-header { position: sticky; top: 0; z-index: 20; background: rgba(243, 239, 230, 0.9); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); border-bottom: 1px solid var(--ink); transition: background 0.35s, color 0.35s, border-color 0.35s; }
  .site-header.on-cover { background: var(--cover-tone, #26221E); color: #F3EFE6; border-bottom-color: transparent; }
  .site-header.on-cover a:hover { color: #FF6A4D; }
  .site-header.on-cover nav .room { color: #FF6A4D; }
  .bar { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 10px 24px; padding-block: 14px; }
  .mark { display: flex; align-items: baseline; gap: 12px; text-decoration: none; }
  .mark .ja { font-size: 19px; font-weight: var(--w-black); letter-spacing: 0.16em; }
  .mark .en { font: italic 400 18px var(--f-serif); }
  nav { display: flex; flex-wrap: wrap; gap: 4px 22px; font: 400 12px var(--f-mono); letter-spacing: 0.08em; text-transform: uppercase; }
  nav a { text-decoration: none; padding-block: 6px; }
  nav .room { color: var(--red); }
  @media (max-width: 600px) { .mark .en { display: none; } nav { gap: 4px 16px; font-size: 11px; } }
</style>
