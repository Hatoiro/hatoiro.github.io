---
import { socials, profile } from '../data/site';
const year = new Date().getFullYear();
---
<footer class="site-footer dark" id="contact">
  <div class="wrap">
    <p class="kicker">Elsewhere</p>
    <ul class="links">
      {socials.map((s) => (
        <li><a href={s.url} rel="me noopener"><span class="n">{s.name}</span><span class="h">{s.handle} ↗</span></a></li>
      ))}
      <li><a href="/room/"><span class="n">My room</span><span class="h">晴翔の部屋 ↗</span></a></li>
    </ul>
    <div class="end">
      <p class="big">{profile.nameJa}</p>
      <p class="small">© {year} {profile.nameEn}</p>
    </div>
  </div>
</footer>

<style>
  .site-footer { padding-block: 88px 48px; }
  .links { list-style: none; margin: 20px 0 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(260px, 100%), 1fr)); border-top: 1px solid var(--line-on-dark); }
  .links a { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 2px 12px; min-height: 72px; height: 100%; box-sizing: border-box; padding: 20px 16px 20px 0; text-decoration: none; }
  .links li { border-bottom: 1px solid var(--line-on-dark); }
  .n { font: 400 30px var(--f-serif); white-space: nowrap; }
  .h { margin-left: auto; white-space: nowrap; font: 400 12px var(--f-mono); color: var(--muted-on-dark); }
  .end { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 16px; margin-top: 96px; }
  .big { margin: 0; font-size: clamp(56px, 10vw, 104px); font-weight: var(--w-black); letter-spacing: 0.12em; line-height: 1; }
  .small { margin: 0; font: 400 12px var(--f-mono); color: var(--muted-on-dark); }
</style>
