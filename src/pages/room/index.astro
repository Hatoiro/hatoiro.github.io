---
import Base from '../../layouts/Base.astro';
import { roomPanels, order, names } from '../../data/room';
import episodes from '../../data/episodes.json';
import pos2d from '../../data/room-2d-spots.json';

const latest = (episodes as { title: string; published: string; url: string }[])[0];
const panels = roomPanels(latest);
const data = JSON.stringify({ panels, order, names, pos2d }).replace(/</g, '\\u003c');
---
<Base title="My room" description="石黒晴翔の部屋を、3Dで歩き回る。物をタップすると、その物にまつわる話が開く。" bodyClass="room-page">
  <div class="app">
    <header class="bar">
      <a href="/" class="brand"><span class="t">My <em>room</em></span><span class="s">晴翔の部屋</span></a>
      <div class="ctrls">
        <div class="seg" role="group" aria-label="時間帯">
          <button type="button" data-tod="morning" aria-pressed="false">朝</button>
          <button type="button" data-tod="day" aria-pressed="false">昼</button>
          <button type="button" data-tod="night" aria-pressed="false">夜</button>
        </div>
        <button type="button" class="rpill" id="mode" hidden>2Dで見る</button>
        <a class="rpill" href="/">ハブへ</a>
      </div>
    </header>
    <main class="stage" id="stage">
      <div id="view"></div>
      <div class="loading" id="loading">部屋を組み立てています…</div>
      <div class="tools"><button type="button" class="rpill" id="reset">全体を見る</button><span id="hint"></span></div>
    </main>
    <aside class="panel" id="panel" aria-live="polite">
      <button type="button" class="rpill" id="sheet-close">← 部屋に戻る</button>
      <p class="pkicker" id="p-kicker"></p>
      <h1 class="ptitle" id="p-title"></h1>
      <p class="pbody" id="p-body"></p>
      <ul class="items" id="p-items"></ul>
      <div class="links" id="p-links"></div>
      <nav class="index" aria-label="部屋の物の一覧"><p>一覧から選ぶ</p><div id="chips"></div></nav>
    </aside>
  </div>
  <script type="application/json" id="room-data" set:html={data}></script>
</Base>

<script>
  import '../../scripts/room/app.js';
</script>

<style is:global>
  .room-page { --bg: #F3EFE6; --fg: #111010; --rmuted: #5C5850; --rline: #CFC9BC; --accent: #B5341C; height: 100%; overflow: hidden; background: var(--bg); color: var(--fg); transition: background 0.8s, color 0.8s; }
  :root[data-tod=morning] .room-page { --bg: #F5EEE2; }
  :root[data-tod=night] .room-page { --bg: #15161C; --fg: #EDE9DF; --rmuted: #A6A8B4; --rline: #33343F; --accent: #FF6A4D; }
  html:has(.room-page) { height: 100%; }
  .room-page .app { display: grid; grid-template-columns: minmax(0, 1fr) 380px; grid-template-rows: auto minmax(0, 1fr); height: 100dvh; }
  .room-page .bar { grid-column: 1 / -1; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px; padding: 12px 24px; border-bottom: 1px solid var(--rline); }
  .room-page .brand { display: flex; align-items: baseline; gap: 12px; text-decoration: none; }
  .room-page .brand .t { font: 400 32px/1 var(--f-serif); }
  .room-page .brand .s { font-size: 13px; color: var(--rmuted); }
  .room-page .ctrls { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; }
  .room-page .seg { display: flex; gap: 4px; padding: 4px; border: 1px solid var(--rline); border-radius: 999px; }
  .room-page .seg button { min-height: 38px; min-width: 56px; padding: 0 14px; border: 0; border-radius: 999px; background: transparent; cursor: pointer; font-size: 14px; font-weight: 700; }
  .room-page .seg button[aria-pressed=true] { background: var(--fg); color: var(--bg); }
  .room-page .rpill { min-height: 44px; padding: 0 18px; display: inline-flex; align-items: center; border: 1px solid currentColor; border-radius: 999px; background: transparent; cursor: pointer; font: 400 13px var(--f-mono); text-decoration: none; color: inherit; }
  .room-page .stage { position: relative; overflow: hidden; }
  .room-page #view { position: absolute; inset: 0; }
  .room-page #view canvas.gl { position: absolute; inset: 0; display: block; touch-action: none; cursor: grab; }
  .room-page .spots3d { position: absolute; inset: 0; pointer-events: none; }
  .room-page .spot { position: absolute; left: 0; top: 0; width: 44px; height: 44px; padding: 0; border: 0; background: transparent; cursor: pointer; pointer-events: auto; display: flex; align-items: center; justify-content: center; }
  .room-page .dot { width: 12px; height: 12px; border-radius: 50%; background: #B5341C; border: 2px solid #F3EFE6; animation: rpulse 1.8s infinite; transition: width 0.2s, height 0.2s; }
  .room-page .spot[aria-pressed=true] .dot { width: 18px; height: 18px; }
  .room-page .lbl { position: absolute; bottom: 40px; left: 50%; transform: translate(-50%, 4px); padding: 4px 10px; background: #111010; color: #F3EFE6; font-size: 13px; font-weight: 700; white-space: nowrap; opacity: 0; transition: opacity 0.2s, transform 0.2s; pointer-events: none; }
  .room-page .spot:hover .lbl, .room-page .spot:focus-visible .lbl, .room-page .spot[aria-pressed=true] .lbl { opacity: 1; transform: translate(-50%, 0); }
  @keyframes rpulse { 0% { box-shadow: 0 0 0 0 rgba(181, 52, 28, 0.55); } 100% { box-shadow: 0 0 0 14px rgba(181, 52, 28, 0); } }
  .room-page .fig2d { position: absolute; inset: 16px; display: flex; align-items: center; justify-content: center; }
  .room-page .room2d { position: relative; line-height: 0; max-width: 100%; }
  .room-page .room2d img { display: block; max-width: 100%; max-height: calc(100dvh - 130px); height: auto; }
  .room-page .spots2d { position: absolute; inset: 0; pointer-events: none; }
  .room-page .spots2d .spot { pointer-events: auto; }
  .room-page .tools { position: absolute; left: 16px; bottom: 16px; display: flex; flex-wrap: wrap; align-items: center; gap: 12px; pointer-events: none; }
  .room-page .tools .rpill { pointer-events: auto; background: var(--bg); }
  .room-page #hint { font: 400 12px var(--f-mono); color: var(--rmuted); }
  .room-page .loading { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; font: 400 28px var(--f-serif); color: var(--rmuted); background: var(--bg); }
  .room-page .panel { background: #111010; color: #EDE9DF; padding: 28px; display: flex; flex-direction: column; gap: 20px; overflow: auto; }
  :root[data-tod=night] .room-page .panel { background: #0B0B0E; }
  .room-page .pkicker { margin: 0; font: 400 12px var(--f-mono); letter-spacing: 0.08em; color: #FF6A4D; }
  .room-page .ptitle { margin: 0; font: 400 48px/1.05 var(--f-serif); text-wrap: balance; white-space: pre-line; }
  .room-page .pbody { margin: 0; font-size: 15px; line-height: 1.9; color: #CFCAC0; }
  .room-page .items { list-style: none; margin: 0; padding: 0; border-top: 1px solid #3A3833; }
  .room-page .items li { display: flex; flex-direction: column; gap: 2px; padding: 12px 0; border-bottom: 1px solid #3A3833; }
  .room-page .items span { font-size: 13px; color: #A8A39A; }
  .room-page .links { display: flex; flex-wrap: wrap; gap: 8px; }
  .room-page .links .btn { min-height: 44px; padding: 0 18px; display: inline-flex; align-items: center; border: 1px solid #EDE9DF; color: #EDE9DF; text-decoration: none; font-size: 14px; font-weight: 700; }
  .room-page .links .btn.primary { background: #EDE9DF; color: #111010; }
  .room-page .index { margin-top: auto; padding-top: 18px; border-top: 1px solid #3A3833; display: flex; flex-direction: column; gap: 10px; }
  .room-page .index p { margin: 0; font-size: 13px; color: #A8A39A; }
  .room-page #chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .room-page .chip { min-height: 36px; padding: 0 12px; border-radius: 999px; border: 1px solid #4A4740; background: transparent; color: #EDE9DF; cursor: pointer; font-size: 13px; }
  .room-page .chip[aria-pressed=true] { background: #EDE9DF; color: #111010; }
  .room-page #sheet-close { display: none; }
  @media (max-width: 900px) {
    .room-page .app { grid-template-columns: minmax(0, 1fr); }
    .room-page .brand .t { font-size: 26px; }
    .room-page .panel { position: fixed; left: 0; right: 0; bottom: 0; max-height: 24dvh; padding: 18px 20px; border-radius: 18px 18px 0 0; transition: max-height 0.35s; z-index: 5; }
    .room-page.sheet-open .panel { max-height: 62dvh; }
    .room-page .ptitle { font-size: 36px; }
    .room-page #sheet-close { display: inline-flex; align-self: flex-start; }
    .room-page .tools { bottom: calc(24dvh + 12px); }
  }
</style>
