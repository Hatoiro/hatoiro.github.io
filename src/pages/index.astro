---
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Darkroom from '../components/Darkroom.astro';
import { profile, podcast, instagram, issues, currentIssue, featuredWork, works, lab, hub, journeys } from '../data/site';
import Lightbox from '../components/Lightbox.astro';
import photos from '../data/photos.json';
import episodes from '../data/episodes.json';

type Ep = { id: string; title: string; published: string; thumbnail: string; url: string };
const eps = episodes as Ep[];
const latest = eps[0];
const recent = eps.slice(1, 5);
const fmt = (d: string) => d ? d.slice(0, 10).replaceAll('-', '.') : '';
const covers = photos.covers as Record<string, string>;
const workImages = (photos as { works?: Record<string, { thumb: string; full: string; title: string }[]> }).works ?? {};
const ytId = (u = '') => (u.match(/(?:v=|youtu\.be\/|\/live\/|\/shorts\/|\/embed\/)([\w-]{11})/) || [])[1];
type MapRoll = { id: string; label: string; year?: string; period?: string; note?: string; frames: { thumb: string; full: string }[] };
// 日付のある旅（新しい順）→ 日付のないロール（Kanto・High School など）の順
const mapRolls = (photos.rolls as MapRoll[]).filter((r) => r.frames.length);
const trips = [...mapRolls.filter((r) => r.year), ...mapRolls.filter((r) => !r.year)].map((r) => {
  const j = journeys[r.id] ?? {};
  return { id: r.id, name: j.title ?? r.label, period: j.period ?? (r.period || r.note || ''), place: j.place ?? '', img: r.frames[0].full, count: r.frames.length, learnings: j.learnings?.length ?? 0 };
});
const MAP_FIRST = 4; // トップで最初に見せる数。残りは「もっと見る」で開く
const featShotKey = (featuredWork as { images?: string }).images;
const featShot = featShotKey ? workImages[featShotKey]?.[0] : undefined;
const shownWorks = works.filter((w) => (w.kind === 'Video' ? !!ytId(w.youtube) : true));
const bars = Array.from({ length: 40 }, (_, i) => ({ h: 30 + ((i * 37) % 70), d: ((i * 0.07) % 1.3).toFixed(2) }));
---
<Base>
  <SiteHeader />
  <main>
    <!-- ===== Cover: each year is an issue. Full screen at first, pulls back into a card on scroll ===== -->
    <section class="cover-stage" aria-label="表紙" data-cover-stage>
      <div class="cover-clip dark">
        {issues.map((iss) => (
          <div class="cover" data-issue-panel={iss.id} data-tone={iss.tone} hidden={iss.id !== currentIssue} style={`--tone:${iss.tone}`}>
            {covers[iss.id] && <img class="cover-bg" src={covers[iss.id]} alt="" />}
            <div class="cover-inner">
              <div class="cover-top"><span>The Haruto Ishiguro Archive</span><span>{iss.kicker}</span></div>
              <h1 class="masthead">Haruto<br />Ishiguro</h1>
              <ol class="lines">
                {iss.lines.map((l) => <li><span class="k">{l.k}</span><span class="v">{l.v}</span></li>)}
              </ol>
            </div>
            <p class="big-year" aria-hidden="true">{iss.big}</p>
          </div>
        ))}
        <div class="issue-tabs" role="group" aria-label="号を選ぶ">
          <span class="back">Back issues ←</span>
          {issues.map((iss) => (
            <button type="button" class="pill" data-issue={iss.id} aria-pressed={iss.id === currentIssue ? 'true' : 'false'}>{iss.tab}</button>
          ))}
        </div>
      </div>
    </section>

    <!-- ===== Podcast ===== -->
    <section id="studyroom" class="wrap band">
      <div class="head">
        <div>
          <p class="kicker">{hub.podcastKicker}</p>
          <h2 class="sec-title">noisy<span class="thin">studyroom</span></h2>
        </div>
        <p class="lede">{podcast.tagline}{podcast.about.replace(podcast.tagline, '')}</p>
      </div>
      <div class="pod">
        <a class="pod-thumb" href={latest?.url ?? podcast.youtube}>
          {latest ? <img src={latest.thumbnail} alt="" loading="lazy" /> : <span class="pod-ph">noisystudyroom</span>}
          <span class="play" aria-hidden="true"><svg width="30" height="30" viewBox="0 0 24 24"><path d="M8 5v14l11-7z" fill="#F3EFE6"></path></svg></span>
        </a>
        <div class="pod-side">
          <div>
            <p class="pod-meta">{latest ? `最新回 · ${fmt(latest.published)}` : '最新回'}</p>
            <h3 class="pod-title">{latest?.title ?? '最新回は YouTube で'}</h3>
          </div>
          <div class="eq" aria-hidden="true">{bars.map((b) => <span style={`height:${b.h}%;animation-delay:${b.d}s`}></span>)}</div>
          <div class="btns">
            <a class="btn solid" href={latest?.url ?? podcast.youtube}>YouTube で見る</a>
            {podcast.spotify && <a class="btn" href={podcast.spotify}>Spotify で聴く</a>}
            <a class="btn" href="/studyroom/">全エピソード</a>
          </div>
        </div>
      </div>
      {recent.length > 0 && (
        <ul class="eps">
          {recent.map((e) => (
            <li><a href={e.url}><img src={e.thumbnail} alt="" loading="lazy" /><span class="d">{fmt(e.published)}</span><span class="t">{e.title}</span></a></li>
          ))}
        </ul>
      )}
    </section>

    <!-- ===== Darkroom ===== -->
    <section id="darkroom" class="dark darkroom-band">
      <div class="wrap">
        <div class="head">
          <div>
            <p class="kicker">{hub.darkroomKicker}</p>
            <h2 class="sec-title">Dark<span class="thin">room</span></h2>
          </div>
          <p class="lede">{hub.darkroomLede}</p>
        </div>
        <Darkroom />
        <div class="insta">
          <div class="insta-text">
            <p class="kicker">Instagram</p>
            <p class="insta-title">{hub.instaTitle}</p>
            {instagram.url ? <a class="btn solid" href={instagram.url}>@{instagram.handle} をフォロー</a> : <p class="soon">{hub.instaSoon}</p>}
            <a class="btn" href="/darkroom/">Darkroom をぜんぶ見る</a>
          </div>
        </div>
      </div>
    </section>

    <!-- ===== Map room (旅) ===== -->
    {trips.length > 0 && (
      <section id="map" class="wrap band map">
        <div class="head">
          <div>
            <p class="kicker">{hub.mapKicker}</p>
            <h2 class="sec-title">Map <span class="thin">room</span></h2>
          </div>
          <p class="lede">{hub.mapLede}</p>
        </div>
        <ul class="trips" id="trips">
          {trips.map((t, i) => (
            <li class={i >= MAP_FIRST ? 'more' : ''}>
              <a href={`/darkroom/${t.id}/`}>
                <span class="trip-img"><img src={t.img} alt="" loading="lazy" /></span>
                <span class="trip-name">{t.name}</span>
                <span class="trip-meta">{[t.period, t.place].filter(Boolean).join(' · ')}</span>
                <span class="trip-tags"><span>{t.count} frames</span>{t.learnings > 0 && <span class="learn">学び {t.learnings}</span>}</span>
              </a>
            </li>
          ))}
        </ul>
        {trips.length > MAP_FIRST && (
          <button type="button" class="more-btn" aria-controls="trips" aria-expanded="false" data-more={`もっと見る（あと ${trips.length - MAP_FIRST}）`} data-less="閉じる">
            もっと見る（あと {trips.length - MAP_FIRST}）
          </button>
        )}
      </section>
    )}

    <!-- ===== Archive room (年譜) ===== -->
    <section id="archive" class="wrap band">
      <h2 class="sec-title archive-title">Archive <span class="thin">room</span></h2>
      <div class="chron">
        <div class="chron-side">
          <div class="sticky">
            <p class="kicker">{hub.chronicleKicker}</p>
            {issues.map((iss) => (
              <div data-issue-panel={iss.id} hidden={iss.id !== currentIssue}>
                <p class="chron-year">{iss.big}</p>
                <p class="chron-theme">{iss.theme}</p>
              </div>
            ))}
            <div class="chron-tabs" role="group" aria-label="年を選ぶ">
              {issues.map((iss) => <button type="button" class="pill" data-issue={iss.id} aria-pressed={iss.id === currentIssue ? 'true' : 'false'}>{iss.tab}</button>)}
            </div>
          </div>
        </div>
        <div class="chron-list">
          {issues.map((iss) => (
            <ol data-issue-panel={iss.id} hidden={iss.id !== currentIssue}>
              {iss.entries.map((e) => (
                <li>
                  <span class="m">{e.m}</span>
                  <div><span class="tag">{e.tag}</span><h3>{e.roll ? <a href={`/darkroom/${e.roll}/`}>{e.title} →</a> : e.title}</h3>{e.body && <p>{e.body}</p>}</div>
                </li>
              ))}
            </ol>
          ))}
        </div>
      </div>
    </section>

    <!-- ===== Lab room (作品) ===== -->
    <section id="lab" class="wrap band works">
      <p class="kicker">{hub.worksKicker}</p>
      <h2 class="sec-title">Lab <span class="thin">room</span></h2>
      <div class="works-grid">
        <a class={featShot ? 'feature has-shot' : 'feature'} href={featuredWork.url}>
          <span class="feature-text">
            <span class="meta light">{featuredWork.kind} · {featuredWork.year} · Live</span>
            <span class="feature-name">{featuredWork.title}</span>
            <span class="feature-body">{featuredWork.body}</span>
            <span class="feature-cta">{featuredWork.cta} →</span>
          </span>
          {featShot && <span class="feature-shot"><img src={featShot.full} alt={`${featuredWork.title} の画面`} loading="lazy" /></span>}
        </a>
        {shownWorks.map((w) => {
          const id = ytId(w.youtube);
          const pages = w.images ? workImages[w.images] ?? [] : [];
          const meta = [w.kind, w.year].filter(Boolean).join(' · ');
          return (
            <article class="work">
              {id ? (
                <a class="media video" href={w.youtube}>
                  <img src={`https://i.ytimg.com/vi/${id}/hqdefault.jpg`} alt="" loading="lazy" />
                  <span class="play" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24"><path d="M8 5v14l11-7z" fill="#F3EFE6"></path></svg></span>
                </a>
              ) : pages.length ? (
                <button type="button" class="media print" style={`background:${w.color ?? '#1C1A18'}`} data-lb-src={pages[0].full} data-lb-group={`work-${w.images}`} data-lb-cap={`${w.title} · 1`} aria-label={`${w.title} をひらく`}>
                  <img src={pages[0].thumb} alt="" loading="lazy" />
                  <span class="pages">{pages.length} pages</span>
                </button>
              ) : (
                <div class="media type" style={`background:${w.color ?? '#1C1A18'}`} aria-hidden="true"><span>{w.title}</span></div>
              )}
              {pages.slice(1).map((pg, k) => <span hidden data-lb-src={pg.full} data-lb-group={`work-${w.images}`} data-lb-cap={`${w.title} · ${k + 2}`}></span>)}
              <p class="meta">{meta}</p>
              <h3>{w.title}</h3>
              <p class="wbody">{w.body}</p>
            </article>
          );
        })}
      </div>
      <div class="lab">
        <p class="lab-head">{hub.labHead}</p>
        <ul>
          {lab.map((w) => {
            const shot = w.images ? workImages[w.images]?.[0] : undefined;
            return (
              <li class={shot ? 'has-shot' : ''}>
                {shot && (
                  <button type="button" class="lab-shot" data-lb-src={shot.full} data-lb-cap={w.title} aria-label={`${w.title} の画面を大きく見る`}>
                    <img src={shot.thumb} alt="" loading="lazy" />
                  </button>
                )}
                <span class="lab-text"><strong>{w.title}</strong><span>{w.note}</span></span>
                <span class="st">{w.status}</span>
              </li>
            );
          })}
        </ul>
      </div>
    </section>

    <!-- ===== My room ===== -->
    <a class="room-band" href="/room/">
      <span class="wrap room-inner">
        <span>
          <span class="kicker light">{hub.roomKicker}</span>
          <span class="room-title">{hub.roomTitle}<em>{hub.roomTitleItalic}</em></span>
          <span class="room-sub">{hub.roomSub}</span>
        </span>
        <span class="btn">{hub.roomCta}</span>
      </span>
    </a>
  </main>
  <SiteFooter />
  <Lightbox />
</Base>

<script>
  document.querySelectorAll<HTMLButtonElement>('.more-btn').forEach((b) => {
    const list = document.getElementById(b.getAttribute('aria-controls') ?? '');
    b.addEventListener('click', () => {
      const open = b.getAttribute('aria-expanded') !== 'true';
      b.setAttribute('aria-expanded', String(open));
      list?.classList.toggle('open', open);
      b.textContent = (open ? b.dataset.less : b.dataset.more) ?? '';
      if (!open) list?.scrollIntoView({ block: 'start' });
    });
  });
  const btns = document.querySelectorAll<HTMLButtonElement>('[data-issue]');
  const root = document.documentElement;
  const show = (id: string) => {
    document.querySelectorAll<HTMLElement>('[data-issue-panel]').forEach((p) => {
      p.hidden = p.dataset.issuePanel !== id;
      if (!p.hidden && p.dataset.tone) root.style.setProperty('--cover-tone', p.dataset.tone);
    });
    btns.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.issue === id)));
  };
  btns.forEach((b) => b.addEventListener('click', () => show(b.dataset.issue!)));
  const first = document.querySelector<HTMLElement>('.cover:not([hidden])');
  if (first?.dataset.tone) root.style.setProperty('--cover-tone', first.dataset.tone);

  // Full-screen cover → pulls back into a card as you scroll (driven by --p, 0..1)
  const stage = document.querySelector<HTMLElement>('[data-cover-stage]');
  const header = document.querySelector<HTMLElement>('.site-header');
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
  let queued = false;
  const update = () => {
    queued = false;
    if (!stage) return;
    const p = still ? 0 : Math.min(1, Math.max(0, scrollY / (stage.offsetHeight * 0.55)));
    stage.style.setProperty('--p', p.toFixed(3));
    header?.classList.toggle('on-cover', scrollY < stage.offsetHeight * 0.3);
    if (header) root.style.setProperty('--hdr', header.offsetHeight + 'px');
  };
  addEventListener('scroll', () => { if (!queued) { queued = true; requestAnimationFrame(update); } }, { passive: true });
  addEventListener('resize', update);
  update();
</script>

<style>
  .cover-stage { --p: 0; --side: max(var(--pad), calc((100vw - var(--max)) / 2 + var(--pad))); position: relative; height: calc(100svh - var(--hdr, 58px)); min-height: 620px; }
  .cover-clip { position: absolute; inset: 0; overflow: hidden; background: var(--cover-tone, #26221E);
    clip-path: inset(calc(var(--p) * 28px) calc(var(--p) * var(--side)) calc(var(--p) * 56px) calc(var(--p) * var(--side)));
    transition: background 0.5s; will-change: clip-path; }
  .cover { position: absolute; inset: 0; background: var(--tone); color: #F3EFE6; animation: fade 0.5s ease-out; }
  @keyframes fade { from { opacity: 0.4; } to { opacity: 1; } }
  .cover-bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0.45; }
  .cover-inner { position: relative; z-index: 1; height: 100%; display: flex; flex-direction: column; padding: 28px calc(var(--side) + clamp(16px, 3vw, 44px)) 44px;
    transform: scale(calc(1 - var(--p) * 0.04)); transform-origin: 50% 0; }
  .cover-top { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px; font: 400 12px var(--f-mono); letter-spacing: 0.12em; text-transform: uppercase; }
  .masthead { margin: 12px 0 0; font: 400 clamp(84px, 15vw, 216px)/0.84 var(--f-display); letter-spacing: -0.005em; text-transform: uppercase; }
  .lines { list-style: none; margin: auto 0 0; padding: 24px 0 0; max-width: 600px; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(260px, 100%), 1fr)); gap: 16px 32px; }
  .lines li { display: flex; flex-direction: column; gap: 2px; }
  .lines .k { font: 400 11px var(--f-mono); color: var(--red-on-dark); letter-spacing: 0.14em; text-transform: uppercase; }
  .lines .v { font: 400 clamp(18px, 1.7vw, 24px)/1.2 var(--f-serif); text-wrap: pretty; }
  .big-year { position: absolute; right: calc(var(--side) + 8px); bottom: -0.1em; margin: 0; font: 400 clamp(140px, 18vw, 260px)/1 var(--f-display); color: transparent; -webkit-text-stroke: 2px rgba(243, 239, 230, 0.85); pointer-events: none; }
  .issue-tabs { position: absolute; z-index: 2; right: calc(var(--side) + clamp(16px, 3vw, 44px)); top: calc(64px + var(--p) * 28px); display: flex; flex-wrap: wrap; justify-content: flex-end; align-items: center; gap: 8px; }
  .issue-tabs .back { font: 400 11px var(--f-mono); letter-spacing: 0.12em; text-transform: uppercase; color: rgba(243, 239, 230, 0.7); margin-right: 6px; }
  .issue-tabs .pill { border-color: rgba(243, 239, 230, 0.6); }
  @media (max-height: 820px) and (min-width: 701px) { .masthead { font-size: clamp(84px, 12vw, 168px); } }
  @media (max-width: 700px) { .big-year, .issue-tabs .back { display: none; } .lines { max-width: none; } .cover-inner { padding-bottom: 104px; } .issue-tabs { top: auto; right: auto; left: calc(var(--side) + 16px); bottom: 28px; justify-content: flex-start; } }
  @media (max-width: 700px) and (max-height: 760px) { .lines li:nth-child(n+3) { display: none; } }

  .band { padding-block: clamp(72px, 10vw, 120px); }
  .head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 24px; margin-bottom: 36px; }
  .lede { margin: 0; max-width: 380px; font-size: 16px; }
  .pod { display: flex; flex-wrap: wrap; gap: 32px; }
  .pod-thumb { flex: 999 1 600px; position: relative; aspect-ratio: 16 / 9; background: #1C1A18; display: flex; align-items: center; justify-content: center; overflow: hidden; }
  .pod-thumb img { width: 100%; height: 100%; object-fit: cover; }
  .pod-ph { font: italic 400 clamp(36px, 6vw, 72px) var(--f-serif); color: #EDE9DF; }
  .play { position: absolute; left: 28px; bottom: 28px; width: 84px; height: 84px; border-radius: 50%; background: var(--red); display: flex; align-items: center; justify-content: center; transition: transform 0.2s; }
  .pod-thumb:hover .play { transform: scale(1.06); }
  .pod-side { flex: 1 1 320px; display: flex; flex-direction: column; justify-content: space-between; gap: 28px; }
  .pod-meta { margin: 0 0 8px; font: 400 12px var(--f-mono); color: var(--muted); }
  .pod-title { margin: 0; font-size: 26px; font-weight: var(--w-black); line-height: 1.45; }
  .eq { display: flex; align-items: center; gap: 3px; height: 64px; }
  .eq span { flex: 1 1 0; background: var(--ink); transform-origin: center; animation: eq 1.3s ease-in-out infinite; }
  @keyframes eq { 0%, 100% { transform: scaleY(0.3); } 50% { transform: scaleY(1); } }
  .btns { display: flex; flex-wrap: wrap; gap: 10px; }
  .eps { list-style: none; margin: 40px 0 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr)); gap: 24px; }
  .eps a { display: flex; flex-direction: column; gap: 8px; text-decoration: none; border-top: 1px solid var(--ink); padding-top: 14px; }
  .eps img { aspect-ratio: 16 / 9; object-fit: cover; width: 100%; }
  .eps .d { font: 400 11px var(--f-mono); color: var(--muted); }
  .eps .t { font-size: 15px; font-weight: var(--w-bold); line-height: 1.5; }

  .darkroom-band { position: relative; padding-block: clamp(80px, 10vw, 120px); overflow: hidden; }
  .darkroom-band::before { content: ''; position: absolute; left: 50%; top: -360px; width: 1300px; height: 760px; transform: translateX(-50%); background: radial-gradient(closest-side, rgba(190, 40, 22, 0.22), transparent); pointer-events: none; }
  .darkroom-band .wrap { position: relative; }
  .darkroom-band .lede { color: #CFCAC0; }
  .insta { margin-top: 88px; }
  .insta-text { display: flex; flex-wrap: wrap; align-items: center; gap: 16px 24px; }
  .insta-title { margin: 0; flex: 1 1 280px; font: 400 clamp(36px, 5vw, 64px)/1 var(--f-serif); white-space: pre-line; }
  .soon { margin: 0; color: var(--muted-on-dark); }

  .map { border-bottom: 1px solid var(--ink); }
  .trips { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(260px, 100%), 1fr)); gap: 36px 24px; }
  .trips a { display: flex; flex-direction: column; gap: 8px; text-decoration: none; }
  .trip-img { display: block; aspect-ratio: 4 / 5; overflow: hidden; background: #2E2D2A; }
  .trip-img img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s ease; }
  .trips a:hover .trip-img img { transform: scale(1.04); }
  .trip-name { margin-top: 6px; font: 400 clamp(36px, 4vw, 52px)/0.95 var(--f-display); text-transform: uppercase; }
  .trips a:hover .trip-name { color: var(--red); }
  .trip-meta { font: 400 12px var(--f-mono); color: var(--muted); }
  .trip-tags { display: flex; gap: 8px; font: 400 11px var(--f-mono); }
  .trip-tags span { padding: 3px 8px; border: 1px solid var(--line); }
  .trips li.more { display: none; }
  .trips.open li.more { display: block; animation: rise 0.45s ease both; }
  @keyframes rise { from { opacity: 0; transform: translateY(12px); } }
  .more-btn { display: block; margin: 40px auto 0; padding: 14px 28px; border: 1px solid var(--ink); background: none; color: var(--ink); font: 400 12px var(--f-mono); letter-spacing: 0.12em; cursor: pointer; transition: background 0.2s, color 0.2s; }
  .more-btn:hover { background: var(--ink); color: var(--ivory); }
  .trip-tags .learn { border-color: var(--red); color: var(--red); }
  .archive-title { margin-bottom: 48px; }
  .chron { display: flex; flex-wrap: wrap; gap: 48px; }
  .chron-side { flex: 1 1 300px; }
  .sticky { position: sticky; top: 96px; }
  .chron-year { margin: 10px 0 0; font: 400 clamp(96px, 12vw, 150px)/0.84 var(--f-display); }
  .chron-theme { margin: 16px 0 0; font-size: 20px; font-weight: var(--w-black); }
  .chron-tabs { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 24px; }
  .chron-list { flex: 999 1 560px; }
  .chron-list ol { list-style: none; margin: 0; padding: 0; }
  .chron-list li { display: flex; flex-wrap: wrap; gap: 20px; padding: 24px 0; border-bottom: 1px solid var(--line); }
