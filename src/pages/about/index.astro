---
import Base from '../../layouts/Base.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { profile, experience, education, interests, socials } from '../../data/site';
const linkedin = socials.find((s) => s.name === 'LinkedIn');
---
<Base title="About" description={`${profile.nameEn} — ${profile.headline}`}>
  <SiteHeader />
  <main class="wrap page">
    <p class="kicker">About</p>
    <h1 class="name">{profile.nameJa}<span>{profile.nameEn}</span></h1>
    <p class="headline">{profile.headline} · {profile.location}</p>
    <p class="intro">{profile.intro}</p>

    <section>
      <h2>Experience</h2>
      <ul class="cv">
        {experience.map((x) => <li><span class="p">{x.period}</span><div><strong>{x.role}</strong><span>{x.org}</span><span class="sub">{x.place}</span></div></li>)}
      </ul>
    </section>
    <section>
      <h2>Education</h2>
      <ul class="cv">
        {education.map((x) => <li><span class="p">{x.period}</span><div><strong>{x.school}</strong>{x.detail && <span>{x.detail}</span>}</div></li>)}
      </ul>
    </section>
    <section>
      <h2>Interests</h2>
      <ul class="cv">
        {interests.map((x) => <li><span class="p">{x.t}</span><div><span>{x.s}</span></div></li>)}
      </ul>
    </section>
    {linkedin && <p><a class="btn solid" href={linkedin.url} rel="me noopener">LinkedIn ↗</a></p>}
  </main>
  <SiteFooter />
</Base>
<style>
  .page { padding-block: clamp(64px, 9vw, 112px); max-width: 960px; }
  .name { margin: 12px 0 0; font-size: clamp(52px, 9vw, 96px); font-weight: var(--w-black); line-height: 1; letter-spacing: 0.06em; display: flex; flex-wrap: wrap; align-items: baseline; gap: 8px 20px; }
  .name span { font: italic 400 clamp(28px, 4.5vw, 44px) var(--f-serif); letter-spacing: 0; }
  .headline { margin: 18px 0 0; font-weight: var(--w-bold); }
  .intro { max-width: 620px; margin: 24px 0 64px; }
  section { margin-bottom: 56px; }
  h2 { margin: 0 0 8px; font: 400 12px var(--f-mono); color: var(--red); letter-spacing: 0.14em; text-transform: uppercase; }
  .cv { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--ink); }
  .cv li { display: flex; flex-wrap: wrap; gap: 4px 24px; padding: 18px 0; border-bottom: 1px solid var(--line); }
  .cv .p { flex: 0 0 220px; font: 400 13px var(--f-mono); color: var(--muted); }
  .cv li > div { flex: 1 1 320px; display: flex; flex-direction: column; gap: 2px; }
  .cv strong { font-size: 18px; }
  .cv .sub { font-size: 13px; color: var(--muted); }
</style>
