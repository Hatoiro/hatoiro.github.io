---
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
---
<Base title="Not found">
  <SiteHeader />
  <main class="wrap page">
    <p class="kicker">404</p>
    <h1 class="sec-title">Not <span class="thin">developed</span> yet.</h1>
    <p class="sub">このコマは、まだ現像されていない。</p>
    <p><a class="btn solid" href="/">表紙に戻る</a></p>
  </main>
</Base>
<style>.page { padding-block: 120px; min-height: 70vh; } p { margin-top: 32px; } .sub { font-size: 18px; }</style>
