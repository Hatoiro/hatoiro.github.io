---
import '../styles/global.css';
import { draft, profile, shareDescription } from '../data/site';

interface Props { title?: string; description?: string; bodyClass?: string; }
const { title, description = shareDescription, bodyClass = '' } = Astro.props;
const fullTitle = title ? `${title} — ${profile.nameJa}` : `${profile.nameJa} ${profile.nameEn}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
// Google の検索結果に出る「サイト名」（ないと github.io の GitHub と表示される）。トップページにだけ置く
const siteLd = Astro.url.pathname === '/' ? JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: profile.nameJa,
  alternateName: [profile.nameEn, `${profile.nameJa} ${profile.nameEn}`],
  url: 'https://hatoiro.github.io/',
}) : '';
---
<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  {draft && <meta name="robots" content="noindex" />}
  <link rel="canonical" href={canonical} />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <meta name="google-site-verification" content="lR71M2NqRQI-31ziELAO20WZpY-OTmnNRwTNjix2sqs" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={profile.nameJa} />
  {siteLd && <script type="application/ld+json" set:html={siteLd} />}
  <meta property="og:url" content={canonical} />
  <meta name="theme-color" content="#111010" />
  <link rel="icon" href="/favicon.ico" sizes="48x48" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
  <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96.png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Anton&family=Instrument+Serif:ital@0;1&family=Noto+Sans:wght@400;500;700;900&family=Murecho:wght@400;700;900&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <slot name="head" />
</head>
<body class={bodyClass}>
  <slot />
</body>
</html>
